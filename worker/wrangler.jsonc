// The Worker project (README.md, "設定檔"). The top level is what every
// environment shares; each environment is one block under "env". There is no
// "build": deploying runs no command of this repository.
{
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  // wrangler sends Cloudflare no usage report.
  "send_metrics": false,
  // The roster's Durable Object keeps its state in SQLite (ADR-0023).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Roster"] }],
  // The CPU time one invocation may use, in every environment: 300,000 ms, the most that can
  // be set. Without it the hourly schedule was stopped after about 30 seconds, less than the
  // tree of one CRL takes; how much the schedule gets with it is not measured yet (README.md,
  // "Cloudflare 上第一次建樹"). A round of the CRL mirror counts on this number
  // (src/round-budget.ts); a configuration in which an environment has another one does not
  // pass the checks of a deploy build (scripts/deploy-build-checks.ts).
  // It is the limit of every invocation, not of the schedule alone: of each HTTP request, and
  // of each call and alarm of the roster's Durable Object. A request can make the Worker
  // compute for that long only if the code lets it: README.md, "設定檔", says why it cannot now.
  "limits": { "cpu_ms": 300000 },
  "env": {
    // The test site (ADR-0028).
    "test": {
      "name": "iamreal-test",
      // Only the custom domain test.iamreal.tw, which is set in the dashboard (ADR-0029).
      "workers_dev": false,
      "preview_urls": false,
      // The CRL mirror, every hour.
      "triggers": { "crons": ["0 * * * *"] },
      "durable_objects": { "bindings": [{ "name": "ROSTER", "class_name": "Roster" }] },
      // The public files, downloaded from test-data.iamreal.tw (ADR-0027).
      "r2_buckets": [{ "binding": "DATA", "bucket_name": "iamreal-test-data" }],
      // Static Assets: the files of site/, which the Worker sends with its own headers
      // (src/visitor.ts; README.md, "頁面和檔案"). site/pages.css, the visitors' style sheet, is in
      // the repository; site/proof/ is where a build of web/ goes, and no deploy puts one there yet.
      // Every request runs the Worker first ("run_worker_first"), so no file is served past its
      // code; a path is a file's own or nothing ("html_handling", "not_found_handling": no
      // index.html found for a directory, no redirect, no page for what is not there).
      "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
      "vars": {
        // The name of the roster's Durable Object: clearing the test roster is giving it a new name.
        // The name of a test roster's object always starts with "test-"; keep that when changing it.
        // The production roster's never does.
        "ROSTER_OBJECT_NAME": "test-1",
        // Which roster this environment serves, "test" or "production". It selects the scope
        // string and the platform table, which are written in protocol/ (src/settings.ts).
        // It must fit the name above: "test" with a name that starts with "test-", "production"
        // with one that does not. Otherwise the API answers nothing but 500 (src/settings.ts),
        // and test/environments.test.ts fails before that.
        "ROSTER_KIND": "test",
        // The date the test roster was last cleared on, YYYY-MM-DD: every page says it beside the mark
        // of a test roster (design/copy/test-site.md). It has not been cleared yet, so this is the date
        // the test site was first deployed (README.md, "第一次部署量到的"). Change it together with
        // ROSTER_OBJECT_NAME when the roster is cleared.
        "TEST_ROSTER_CLEARED_ON": "2026-11-19"
      }
    }
  }
}
