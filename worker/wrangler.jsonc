// The Worker project (README.md, "設定檔"). The top level is what every
// environment shares; each environment is one block under "env". There is no
// "build": deploying runs no command of this repository.
{
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  // wrangler sends Cloudflare no usage report.
  "send_metrics": false,
  // The proof log's Durable Object keeps its state in SQLite (ADR-0023). Cloudflare keeps every
  // migration it has applied on the list, so v1 stays: it made the class under its first name.
  // v2 deletes that class with the objects it had, the test log cleared then (README.md,
  // "清空測試的證明紀錄"), and makes the class of the new name.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Roster"] },
    { "tag": "v2", "deleted_classes": ["Roster"], "new_sqlite_classes": ["ProofLog"] },
    // v3 makes the class of the object that takes the counts (src/counts.ts). It keeps the counts
    // in memory and stores nothing but its alarm.
    { "tag": "v3", "new_sqlite_classes": ["Counts"] },
    // v4 makes the class of the object that keeps the site-wide limit (src/starts.ts). It keeps its count
    // in memory and stores nothing.
    { "tag": "v4", "new_sqlite_classes": ["Starts"] }
  ],
  // The CPU time one invocation may use, in every environment: 300,000 ms, the most that can
  // be set. Without it the hourly schedule was stopped after about 30 seconds, less than the
  // tree of one CRL takes; how much the schedule gets with it is not measured yet (README.md,
  // "Cloudflare 上第一次建樹"). A round of the CRL mirror counts on this number
  // (src/round-budget.ts); a configuration in which an environment has another one does not
  // pass the checks of a deploy build (scripts/deploy-build-checks.ts).
  // It is the limit of every invocation, not of the schedule alone: of each HTTP request, and
  // of each call and alarm of the proof log's Durable Object. A request can make the Worker
  // compute for that long only if the code lets it: README.md, "設定檔", says why it cannot now.
  "limits": { "cpu_ms": 300000 },
  // Static Assets: the files of site/, which Cloudflare sends itself (README.md, "Static Assets").
  // site/pages.css, the visitors' style sheet, site/copy.js, the copy buttons' script, site/count.js,
  // the counts of the visitors' pages, site/demo.js, the player of the demonstration on the page of
  // hanging a proof (the two written by scripts/site-files.ts),
  // site/favicon.ico, the site's icon (scripts/favicon.ts),
  // site/fonts/, the headings' typeface (a copy of design/fonts/), and site/og-image.png, the
  // link preview's image (a copy of design/screens/og-image.png), are in the repository;
  // site/proof/ is where the card proof page goes, the test site's build of web/: every
  // deploy builds it there first and checks what the directory then holds (scripts/deploy.ts,
  // `buildSite`; scripts/deploy-build-checks.ts, `checkProofPages`). It is not in the repository.
  // - "run_worker_first": the Worker runs first for every path but the files' own: /copy.js, /count.js, /demo.js, /favicon.ico, /fonts/*, /og-image.png, /pages.css, /proof
  //   and everything under /proof/ (a "!" pattern wins over "/*"). There Static Assets looks for a file
  //   first, and a file that is there is sent without running the Worker. In the local workerd a request
  //   for one of those paths never runs the Worker, whether the file is there or not. On Cloudflare
  //   that was seen for a file that is not there (2026-11-20: Static Assets answers 404 itself); for a
  //   file that is there it waits for the first deploy with one (README.md, "Static Assets").
  // - No "binding": the Worker cannot read the files, so whichever it is, none of its code can choose
  //   what a card holder is sent as a file of the card proof page.
  // - Their headers are site/_headers and the one address of /proof is site/_redirects, both written
  //   by scripts/site-files.ts; a path is otherwise a file's own or 404 ("html_handling",
  //   "not_found_handling": no index.html found for a directory, no page for what is not there).
  "assets": { "directory": "./site", "run_worker_first": ["/*", "!/copy.js", "!/count.js", "!/demo.js", "!/favicon.ico", "!/fonts/*", "!/og-image.png", "!/pages.css", "!/proof", "!/proof/*"], "html_handling": "none", "not_found_handling": "none" },
  "env": {
    // The test site (ADR-0028).
    "test": {
      "name": "iamreal-test",
      // Only the custom domains test.iamreal.tw and its app domain test-app.iamreal.tw (APP_DOMAIN below),
      // which are set in the dashboard (ADR-0029).
      "workers_dev": false,
      "preview_urls": false,
      // The CRL mirror, every hour.
      "triggers": { "crons": ["0 * * * *"] },
      // PROOF_LOG: the proof log's object. COUNTS: the object that takes the counts (ADR-0032), which
      // is another one, so that counts never wait on the proof log or it on them. STARTS: the object that
      // keeps the site-wide limit (ADR-0026; src/starts.ts), another again, so that neither of the others
      // being overloaded stops card proofs from starting through it.
      "durable_objects": {
        "bindings": [
          { "name": "PROOF_LOG", "class_name": "ProofLog" },
          { "name": "COUNTS", "class_name": "Counts" },
          { "name": "STARTS", "class_name": "Starts" }
        ]
      },
      // The public files, downloaded from test-data.iamreal.tw (ADR-0027).
      // DATA: the public data (ADR-0027). CONNECTION_LOG: the bucket the connection log is written
      // to (ADR-0022), under "connection/": a bucket with no public domain, apart from the public
      // data, whose lifecycle rule deletes every object under that prefix after 31 days (README.md,
      // "連線紀錄"). The maintainer makes the bucket and the rule before the first deploy; every hour the
      // Worker publishes the date of the oldest entry, so that a rule that does not delete shows.
      // The same bucket holds the counts (ADR-0032), under "count-events/", with a rule of their own
      // that deletes after 31 days too, and the same hourly look (README.md, "計數").
      "r2_buckets": [
        { "binding": "DATA", "bucket_name": "iamreal-test-data" },
        { "binding": "CONNECTION_LOG", "bucket_name": "iamreal-test-logs" }
      ],
      // The per-IP limits (ADR-0026; src/rate-limit.ts): one binding to a class of request, each
      // counted by itself, IPv4 by address and IPv6 by /64. On Cloudflare a binding keeps its count on
      // each machine: these stop a network that sends many requests over one connection, not one that
      // opens a connection for each (README.md, "限流"). "limit" is how many requests one
      // network may send in "period" seconds (10 or 60; the code tells a refused request to come
      // back in 60). The numbers are the maintainer's to tune (README.md, "限流"). A namespace_id is
      // an integer of the account's own choosing, one to a counter: never the same for two bindings
      // or two environments, or they would count together.
      "ratelimits": [
        { "name": "RATE_CHALLENGES", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RATE_CARD_STATE", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
        { "name": "RATE_RECORDS", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
        { "name": "RATE_PUBLIC_READS", "namespace_id": "1004", "simple": { "limit": 180, "period": 60 } },
        { "name": "RATE_PAGES", "namespace_id": "1005", "simple": { "limit": 300, "period": 60 } },
        { "name": "RATE_COUNTS", "namespace_id": "1006", "simple": { "limit": 120, "period": 60 } }
      ],
      "vars": {
        // The name of the proof log's Durable Object: clearing the test log is giving it a new name.
        // The name of a test log's object always starts with "test-"; keep that when changing it.
        // The production log's never does.
        "PROOF_LOG_OBJECT_NAME": "test-4",
        // Which proof log this environment serves, "test" or "production". It selects the scope
        // string and the platform table, which are written in protocol/ (src/settings.ts).
        // It must fit the name above: "test" with a name that starts with "test-", "production"
        // with one that does not. Otherwise the API answers nothing but 500 (src/settings.ts),
        // and test/environments.test.ts fails before that.
        "PROOF_LOG_KIND": "test",
        // "true" stops taking card proofs; "false" takes them (ADR-0033; README.md, "停止和恢復收過卡").
        // The maintainer changes it on Cloudflare's dashboard. The next deploy writes this file's value
        // over the dashboard's: to deploy while it is stopped, write "true" here and deploy that.
        "CARD_PROOFS_PAUSED": "false",
        // The name of a rebuild from the proof log the maintainer asks for, or "" for none (ADR-0033;
        // README.md, "從證明紀錄重建"). A name of the maintainer's own (1 to 40 of A-Za-z0-9._-); the proof
        // log's object makes one rebuild for each name, and only while CARD_PROOFS_PAUSED is "true".
        // Changed on Cloudflare's dashboard, like the one above, and written over by the next deploy.
        "REBUILD_PROOF_LOG": "",
        // The date the test log was last cleared on, YYYY-MM-DD: every page says it beside the mark
        // of a test log (design/copy/test-site.md). Change it together with PROOF_LOG_OBJECT_NAME when
        // the proof log is cleared (README.md, "清空測試的證明紀錄").
        "TEST_PROOF_LOG_CLEARED_ON": "2026-11-27",
        // How many counts one minute's file holds at most (ADR-0032; src/counts.ts): plain digits, 0 to
        // 100000. More than that in a minute are not kept; the file says how many there were.
        "COUNT_EVENTS_PER_MINUTE": "600",
        // The site-wide limit (ADR-0026; src/rate-limit.ts, withinStarts): how many card proofs may start in a
        // minute, all networks together, counted on `GET /api/v1/config?start` only, by the object STARTS.
        // Plain digits, 0 to 100000. A starting value for the maintainer to set (README.md, "全站的總量上限").
        "CARD_PROOF_STARTS_PER_MINUTE": "60",
        // The app domain (ADR-0040; README.md, "app 網域"): a second custom domain of this Worker, set in the
        // dashboard, whose every address opens the apps named here. On it the Worker answers the two files a
        // phone's system reads, made from this setting, and the page for a phone without the app; nothing else
        // (src/app-domain.ts). The check of a deploy build holds this to the apps of this site
        // (scripts/deploy-build-checks.ts, `checkAppDomains`).
        // - "apple_team_id": the team of the Apple developer account, in front of each app's identifier in
        //   apple-app-site-association. Not a key: every signed app shows it.
        // - "apps": the apps that open the domain. Before launch both connect to the test site, so both are
        //   here; the development build never is. On launch day the production app goes (ADR-0040).
        // - "android_sha256": the SHA-256 of the signing keys Google made for the app, as Play Console's App
        //   signing page shows them, which assetlinks.json lists. The production app's: the key in use (the
        //   classic one, not the post-quantum one) and the earlier one, both until a phone shows which one the
        //   app is signed with (#534). The test app is not in Play Console yet (#479): none until it is, and
        //   until then it is in apple-app-site-association only.
        "APP_DOMAIN": {
          "host": "test-app.iamreal.tw",
          "apple_team_id": "Z59T4S2753",
          "apps": [
            {
              "id": "tw.iamreal.app",
              "android_sha256": [
                "22:D5:4D:E9:CB:EB:94:9C:B4:A1:E8:0D:B5:4D:4E:98:1D:B9:CF:5C:E2:43:C8:90:79:1F:AF:42:D9:B1:4A:7F",
                "66:06:64:3B:B7:90:85:B0:CC:DD:42:1A:AF:51:E1:59:1B:A4:54:D0:30:8E:1D:DC:B9:BA:59:70:A9:44:94:9B"
              ]
            },
            { "id": "tw.iamreal.app.test", "android_sha256": [] }
          ]
        }
      }
    }
  }
}
