{
  "name": "iamreal-worker",
  "private": true,
  "type": "module",
  "imports": {
    "#target": "./src/target.ts"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "local": "node --experimental-strip-types scripts/local.ts",
    "typecheck": "WRANGLER_SEND_METRICS=false WRANGLER_HIDE_BANNER=true wrangler types --env test --strict-vars=false && tsc -p . && tsc -p test",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "deploy:test": "node --experimental-strip-types scripts/deploy-test.ts"
  },
  "dependencies": {
    "iamreal-protocol": "workspace:*",
    "msgpackr": "1.12.1"
  },
  "devDependencies": {
    "@aztec-foundation/bb.js": "6.0.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "wrangler": "4.160.1"
  }
}
