# wrangler's working files: local builds and the simulated bindings' data.
.wrangler/
# The types of the Workers runtime and of the bindings, written by `wrangler types` (pnpm typecheck).
worker-configuration.d.ts
# Test runs: the builds the tests make.
test-output/
# The proof verifier's files, written at each build after their SHA-256 is checked (scripts/engine-files.ts).
generated/
# The build of web/ among the files of Static Assets (wrangler.jsonc, "assets"); site/pages.css is in the repository.
site/proof/
# pnpm local (scripts/local.ts): the proof log, the bucket and the site of the build for a real card on this computer.
local/
