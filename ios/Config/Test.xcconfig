// The test environment: the test site and the test log. The three
// configurations of the project are based on this file, one for each app
// of ADR-0040, so all three talk to the test site: Debug is the
// development build (tw.iamreal.app.dev) and TestApp the test app
// (tw.iamreal.app.test), which always do; Release is the production app
// (tw.iamreal.app), which does until launch. On launch day one PR gives
// Release a file of its own for the production site; Debug and TestApp
// stay on this one. The environment is fixed when the app is built and
// nothing in the app switches it.
//
// IAMREAL_ENVIRONMENT is a compilation condition: App/AppEnvironment.swift
// holds the site and the proof log that go with it and does not compile
// without one. check-app.sh has the identifier of each app and the site
// written in it, and turns away a build that is not that. The name under
// the icon of each app is in the project file (INFOPLIST_KEY_
// CFBundleDisplayName), as design/copy/app.md writes it.
#include "Shared.xcconfig"

IAMREAL_BUNDLE_IDENTIFIER[config=Debug] = tw.iamreal.app.dev
IAMREAL_BUNDLE_IDENTIFIER[config=Release] = tw.iamreal.app
IAMREAL_BUNDLE_IDENTIFIER[config=TestApp] = tw.iamreal.app.test
IAMREAL_ENVIRONMENT = IAMREAL_ENV_TEST
