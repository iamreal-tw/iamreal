// The test environment: the test site and the test log. Both
// configurations of the project are based on this file, so both builds of
// the app (ADR-0037) talk to the test site: Debug is the development build,
// which always does, Release the store's build, which does until launch. On
// launch day one PR gives Release a file of its own for the production
// site. The environment is fixed when the app is built and nothing in the
// app switches it.
//
// IAMREAL_ENVIRONMENT is a compilation condition: App/AppEnvironment.swift
// holds the site and the proof log that go with it and does not compile
// without one. check-app.sh has the identifier of each build and the site
// written in it, and turns away a build that is not that. The name under
// the icon of each build is in the project file (INFOPLIST_KEY_
// CFBundleDisplayName), as design/copy/app.md writes it.
#include "Shared.xcconfig"

IAMREAL_BUNDLE_IDENTIFIER[config=Debug] = tw.iamreal.app.dev
IAMREAL_BUNDLE_IDENTIFIER[config=Release] = tw.iamreal.app
IAMREAL_ENVIRONMENT = IAMREAL_ENV_TEST
