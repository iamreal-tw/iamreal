<?xml version="1.0" encoding="utf-8"?>
<!-- The permissions asked for: the network (the server and the CRL
     archive); NFC, to read the card (card/NfcCard.kt); the reminder's notification (asked for when "開啟提醒" is
     pressed, Android 13 on); and being told the phone restarted, which
     forgets the reminder's alarm (reminder/Phone.kt). A library that brings the advertising ID's permission has it
     taken out here, and the build fails if the merged manifest still names
     it, or asks for anything not listed in app/build.gradle.kts
     (checkManifest). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- A phone without NFC can install the app: design/copy/card-proof.md
         ("1. 開始之前") has it say that this phone cannot read a card, a
         screen of issue #171. Until then a tap on it stops at once. -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Nothing of the app goes into a backup or onto another device. Only
         HTTPS: the app talks to no server without it. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/App"
        android:usesCleartextTraffic="false">
        <!-- A change of the screen (turned, folded, dark) does not start
             the activity again: the screens draw themselves anew. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The reminder's alarm, its "一週後再提醒我", and the system's word
             that the alarm needs setting again (reminder/Phone.kt). No other
             app can call it: the system can, and the app's own pending
             intents. -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- What the libraries of the screens would start by themselves when
             the app opens, taken out: a look for an emoji font, which on a
             phone with Google Play services asks them for one, and the
             installing of a start-up profile, with the receiver that lets
             a development tool ask for it. The app has neither a profile
             nor a use for either. The build fails if the merged manifest
             has a component other apps can call besides the activity above
             (checkManifest). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                tools:node="remove" />
        </provider>
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
