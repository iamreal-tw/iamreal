<?xml version="1.0" encoding="utf-8"?>
<!-- The app domain the test app opens for (ADR-0040; README.md, "app 網域").
     It talks to the test site, before launch and after, so it opens for the
     test site's app domain.
     Every address of the host opens the app, whatever its path, https only;
     the system checks the host's /.well-known/assetlinks.json (autoVerify).
     The app reads nothing of the address: opened by it is the same as opened
     from the home screen (MainActivity.kt). The development build has no
     such file and opens for no app domain. checkManifest
     (app/build.gradle.kts) holds the merged manifest to appDomains. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity android:name="tw.iamreal.app.MainActivity">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="test-app.iamreal.tw" />
            </intent-filter>
        </activity>
    </application>
</manifest>
