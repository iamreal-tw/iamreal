{
  "name": "iamreal-web",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "vite build --mode production",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:e2e": "node --experimental-strip-types test/e2e/run.ts",
    "test:ui": "node --experimental-strip-types test/e2e/ui.ts",
    "local": "node --experimental-strip-types scripts/local.ts",
    "fetch-crs": "node scripts/fetch-crs.mjs"
  },
  "dependencies": {
    "@aztec-foundation/bb.js": "6.0.0",
    "@noir-lang/noir_js": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
